# Football Squares Tracker - API Keys
# Copy this file to .env and fill in your API keys

# Google Gemini (cheapest option)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude
# Get your key at: https://console.anthropic.com
CLAUDE_API_KEY=

# OpenRouter — one key, any vision model (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Default model for OpenRouter imports (users can override per-import).
# Any vision-capable model id from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Password reset emails via Resend (https://resend.com/api-keys).
# Unset = reset links are logged to the server console instead.
RESEND_API_KEY=
# Sender address once your domain is verified in Resend,
# e.g. "SquareSZN <no-reply@squareszn.com>"
EMAIL_FROM=

# Public origin used in password-reset links (and OpenRouter referer).
# Defaults to the incoming request's host, so usually safe to leave unset.
APP_URL=https://squareszn.com

# Server port (optional, defaults to 3001)
PORT=

# Secret used to sign login tokens (recommended in production).
# Any long random string works, e.g.: openssl rand -hex 32
# If unset, a secret is derived from POSTGRES_URL (or persisted locally in dev).
AUTH_SECRET=

# Postgres connection string (optional).
# When set, boards are stored in Postgres instead of server/data/boards.json.
# Required on Vercel — without it, boards are kept in memory and vanish on
# every cold start. Vercel Postgres/Neon sets this automatically when you
# connect a database to the project.
POSTGRES_URL=

# "Sign in with Google" (no client secret needed — ID token flow).
# Create an OAuth Web client at https://console.cloud.google.com/apis/credentials
# with your site in "Authorized JavaScript origins", then paste the client ID.
GOOGLE_CLIENT_ID=
