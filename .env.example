# Football Squares Tracker - API Keys
# Copy this file to .env and fill in your API keys

# Google Gemini (cheapest option)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude
# Get your key at: https://console.anthropic.com
CLAUDE_API_KEY=

# Server port (optional, defaults to 3001)
PORT=

# Secret used to sign login tokens (recommended in production).
# Any long random string works, e.g.: openssl rand -hex 32
# If unset, a secret is derived from POSTGRES_URL (or persisted locally in dev).
AUTH_SECRET=

# Postgres connection string (optional).
# When set, boards are stored in Postgres instead of server/data/boards.json.
# Required on Vercel — without it, boards are kept in memory and vanish on
# every cold start. Vercel Postgres/Neon sets this automatically when you
# connect a database to the project.
POSTGRES_URL=
